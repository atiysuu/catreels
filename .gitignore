# Butun .env varyantlari (.env.yedek, .env.local, .env.bak ...) --
# yedek dosyasi bir kez yanlislikla commit'lendi, GitHub gizli
# anahtar korumasi yakaladi. Desen o yuzden genis.
.env
.env.*
!.env.example
out/
__pycache__/
*.pyc
.venv/
venv/
# Muzik ve efekt dosyalari repoya GIRER (CI'nin erisebilmesi icin).
# Buradaki desen sadece yanlislikla kalan gecici dosyalari eler.
assets/music/_*
assets/sfx/_*
