# ============================================================
#  KONSEPT METNI  (zorunlu degil ama siddetle onerilir)
# ============================================================
# AI Studio'dan ucretsiz alinir, kredi karti istemez:
#   https://aistudio.google.com/apikey
# Bos birakirsaniz konseptler yerel sablon havuzundan gelir (calisir ama tekrarlar).
GEMINI_API_KEY=
# Bos birakin -> en yeni calisan Flash modeli otomatik secilir
# (textgen.py icindeki zincir: 3.7 -> 3.6 -> 3.5 -> 3.5-lite -> 3.1-lite).
# Belirli bir modeli zorlamak isterseniz buraya yazin; zincirin basina gecer.
GEMINI_MODEL=

# ============================================================
#  GORSEL / VIDEO
# ============================================================
# free         -> flux gorselleri + ffmpeg hareketi (bedava, sinirsiz)
# pollinations -> gercek AI video klipleri (Pollen kredisi harcar)
VIDEO_BACKEND=free

# Bos birakilirsa anonim kullanilir: gorseller 576x1024 ile sinirli.
# Ucretsiz kayit (https://enter.pollinations.ai/keys) hem cozunurlugu
# hem de hiz limitini rahatlatir.
POLLINATIONS_API_KEY=
IMAGE_MODEL=flux
VIDEO_MODEL=wan-fast
VIDEO_CLIP_SECONDS=5

# ============================================================
#  REEL BICIMI
# ============================================================
REEL_WIDTH=1080
REEL_HEIGHT=1920
REEL_FPS=30
REEL_SHOTS=7
SHOT_SECONDS=3.4
TRANSITION_SECONDS=0.45
KEYFRAMES_PER_SHOT=2
# MORPH=1 -> cekim ici gecisleri uzatir; poz degisimi kesme yerine
# hareket gibi okunur. Daha yumusak ama daha 'ruyamsi' bir his verir.
MORPH=0

# ============================================================
#  INSTAGRAM
# ============================================================
# Bos birakin -> kod hesap kimligini tokenden kendisi bulur.
# Kurulumun en cok hata alinan adimi buydu; artik gerekmiyor.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0
# instagram -> graph.instagram.com (Instagram Login, onerilen)
# facebook  -> graph.facebook.com  (Facebook Login for Business)
IG_API_FLAVOR=instagram
SHARE_TO_FEED=true

# ============================================================
#  PUBLIC BARINDIRMA  (Meta videoyu buradan indirir)
# ============================================================
# release -> GitHub Release asset (ek kurulum yok)
# r2      -> Cloudflare R2 public bucket
# url     -> PUBLIC_VIDEO_URL ile hazir link
HOST_MODE=release
RELEASE_TAG=reels
# Release'te tutulacak en yeni video sayisi; eskiler otomatik silinir.
KEEP_ASSETS=20
# GITHUB_REPOSITORY=kullanici/depo
# GH_TOKEN=

# R2 kullanacaksaniz:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE=https://pub-xxxx.r2.dev

# ============================================================
#  DAVRANIS
# ============================================================
DRY_RUN=false
# Gorsel uretimi icin ust sinir (dakika). Asilirsa eldeki cekimlerle
# video tamamlanir; takilan bir istek tum is akisini bogmaz.
MAX_GEN_MINUTES=35
# SEED=0   -> 0 rastgele; sabitlerseniz hep ayni kedi uretilir
