# ============================================================
#  Bu dosya yalnizca SIRLARI tasir.
#  Bicim/kalite ayarlari src/config.py icinde durur; buraya ayar
#  yazmak kod guncellemelerini SESSIZCE ezer -- daha once iki kez
#  yasandi (olu Gemini modeli ve eski REEL_SHOTS).
#
#  Gecici bir deneme icin buraya satir ekleyebilirsiniz; ortam
#  degiskeni her zaman kod varsayilanini ezer.  Ornek: REEL_SHOTS=4
# ============================================================

# Bolum senaryosu. AI Studio'dan ucretsiz alinir, kart istemez:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Instagram uzun omurlu token (Meta panelinden 60 gunluk uretilir).
# Hesap kimligi bundan otomatik cozulur, ayrica girmeniz gerekmez.
IG_ACCESS_TOKEN=

# Acilis karesi + video uretimi icin zorunlu; Pollen bakiyesi gerekir.
# https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
