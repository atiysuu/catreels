# ============================================================
#  Bu dosya yalnizca SIRLARI tasir.
#  Bicim ve kalite ayarlari src/config.py icinde durur; boylece
#  tek dogruluk kaynagi olur ve eski .env degerleri kod
#  guncellemelerini sessizce ezmez.
#
#  Bir ayari gecici olarak degistirmek isterseniz buraya satir
#  ekleyin -- ortam degiskeni her zaman kod varsayilanini ezer.
#  Ornek:  REEL_SHOTS=8
# ============================================================

# Konsept metni. AI Studio'dan ucretsiz alinir, kredi karti istemez:
#   https://aistudio.google.com/apikey
# Bos birakilirsa konseptler yerel sablon havuzundan gelir.
GEMINI_API_KEY=

# Instagram uzun omurlu token (Meta panelinden 60 gunluk uretilir).
# Hesap kimligi bundan otomatik cozulur, ayrica girmeniz gerekmez.
IG_ACCESS_TOKEN=

# Pollinations anahtari. Bos olsa da gorseller ucretsiz uretilir, ama
# istek arasi bekleme 16sn olur (anahtarli: 2sn). Ucretli video yolu
# (VIDEO_BACKEND=pollinations) icin zorunlu ve bakiye gerektirir.
POLLINATIONS_API_KEY=
